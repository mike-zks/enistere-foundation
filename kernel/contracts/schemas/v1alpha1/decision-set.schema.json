{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.foundation.enistere.com/v1alpha1/decision-set.schema.json",
  "title": "A2 — Decision Set",
  "description": "Versioned Architecture Decisions of one system, each linked to its drivers (requirements), alternatives, trade-offs, rationale and consequences (FR-ARC-01..03). Desired state — authoritative.",
  "allOf": [{ "$ref": "common.schema.json#/$defs/envelope" }],
  "properties": {
    "kind": { "const": "DecisionSet" },
    "metadata": {
      "properties": { "status": { "enum": ["DRAFT", "PROPOSED", "ACCEPTED", "REJECTED", "SUPERSEDED"] } }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "requirementBaseline", "decisions"],
      "properties": {
        "system": { "$ref": "common.schema.json#/$defs/id" },
        "requirementBaseline": { "$ref": "common.schema.json#/$defs/pinnedContractRef" },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "category", "status", "context", "drivers", "options"],
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/itemId" },
              "title": { "$ref": "common.schema.json#/$defs/text" },
              "category": { "enum": ["ARCHITECTURE", "RUNTIME", "DATA", "INTEGRATION", "SECURITY", "DESIGN", "DEPLOYMENT", "OPERATIONS"] },
              "status": { "enum": ["PROPOSED", "ACCEPTED", "REJECTED", "SUPERSEDED"] },
              "context": { "$ref": "common.schema.json#/$defs/text" },
              "drivers": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/itemId" } },
              "options": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "summary"],
                  "properties": {
                    "id": { "$ref": "common.schema.json#/$defs/itemId" },
                    "summary": { "$ref": "common.schema.json#/$defs/text" },
                    "satisfies": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/itemId" } },
                    "tradeoffs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/text" } },
                    "risks": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/text" } },
                    "operationalComplexity": { "enum": ["LOW", "MEDIUM", "HIGH"] }
                  }
                }
              },
              "chosenOption": { "$ref": "common.schema.json#/$defs/itemId" },
              "rationale": { "$ref": "common.schema.json#/$defs/text" },
              "consequences": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/text" } },
              "supersedes": { "$ref": "common.schema.json#/$defs/itemId" }
            }
          }
        }
      }
    }
  }
}
