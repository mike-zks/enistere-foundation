{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.foundation.enistere.com/v1alpha1/common.schema.json",
  "title": "Enistere Foundation — shared contract primitives (v1alpha1)",
  "description": "Shared primitives of the nine first-class contracts (A1–A9): stable identifier, revision, digest, stable reference, actor, provenance, acceptance and the common document envelope. Language-neutral: the TypeScript kernel interprets this document, it never restates it.",
  "$defs": {
    "apiVersion": {
      "description": "Contract schema version. A single value per schema generation; older values are only accepted through an explicit migration.",
      "const": "foundation.enistere.com/v1alpha1"
    },
    "id": {
      "description": "Stable identifier: lowercase, dot/dash separated. Never reused for another object of the same kind.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*$",
      "maxLength": 120
    },
    "itemId": {
      "description": "Identifier of an item inside a contract (requirement, decision, operation, component...).",
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*(?:[-_.][A-Za-z0-9]+)*$",
      "maxLength": 120
    },
    "revision": {
      "description": "Object revision. A published revision is immutable in its semantics; a change produces a new revision.",
      "type": "integer",
      "minimum": 1
    },
    "digest": {
      "description": "sha256 digest. For a contract: over the RFC 8785 (JCS) canonical serialization of its content (the document without metadata.status). For a source artifact: over its raw bytes.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "dateTime": {
      "description": "RFC 3339 timestamp with an explicit offset. Supplied as input data, never generated during validation.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "kind": {
      "enum": [
        "RequirementBaseline",
        "DecisionSet",
        "EffectiveOrganizationContext",
        "SystemDefinition",
        "DomainContract",
        "ChangeRequest",
        "EvidenceRecord",
        "MaterializationRecord",
        "DesignSystem"
      ]
    },
    "contractRef": {
      "description": "Stable reference to one exact revision of a contract, optionally pinned by digest and narrowed to an item. There is no 'latest' reference.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "revision"],
      "properties": {
        "kind": { "$ref": "#/$defs/kind" },
        "id": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/revision" },
        "digest": { "$ref": "#/$defs/digest" },
        "item": { "$ref": "#/$defs/itemId" }
      }
    },
    "pinnedContractRef": {
      "description": "A contract reference that MUST carry the digest of the referenced revision.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "revision", "digest"],
      "properties": {
        "kind": { "$ref": "#/$defs/kind" },
        "id": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/revision" },
        "digest": { "$ref": "#/$defs/digest" },
        "item": { "$ref": "#/$defs/itemId" }
      }
    },
    "externalRef": {
      "description": "Reference to a governed object that is not an E0 contract yet (Entity Profile, Policy Pack, Design System, Approval Policy...).",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "version"],
      "properties": {
        "type": { "type": "string", "pattern": "^[A-Z][A-Za-z]+$" },
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "actor": {
      "description": "Who acted. The actor type bounds the authority it may exercise (OBSERVE, PROPOSE, DECIDE, COMPILE_APPLY, VERIFY).",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["HUMAN", "AI_AGENT", "COMPILER", "CHECKER", "OBSERVER", "SYSTEM"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "role": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "sourceArtifact": {
      "description": "A source that informed the contract. It keeps its provenance and digest but never becomes the truth of the system by itself.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "uri"],
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "type": { "enum": ["BRIEF", "DOCUMENT", "TICKET", "CONVERSATION", "FORM", "REPOSITORY", "API_CONTRACT", "DIAGRAM", "CONTRACT"] },
        "uri": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "digest": { "$ref": "#/$defs/digest" },
        "title": { "$ref": "#/$defs/text" }
      }
    },
    "provenance": {
      "description": "Where the contract content comes from. Provenance never grants authority: an AI proposal with high confidence is still a proposal.",
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "actor"],
      "properties": {
        "origin": { "enum": ["HUMAN", "IMPORT", "AI_PROPOSAL", "COMPILER", "CHECKER", "OBSERVER", "MIGRATION"] },
        "actor": { "$ref": "#/$defs/actor" },
        "tool": { "$ref": "#/$defs/tool" },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/sourceArtifact" } },
        "derivedFrom": { "type": "array", "items": { "$ref": "#/$defs/pinnedContractRef" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "acceptance": {
      "description": "Explicit DECIDE transition. Required whenever the status records a decision (ACCEPTED, REJECTED).",
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "authority", "actor", "at"],
      "properties": {
        "decision": { "enum": ["ACCEPTED", "REJECTED"] },
        "authority": { "const": "DECIDE" },
        "actor": { "$ref": "#/$defs/actor" },
        "at": { "$ref": "#/$defs/dateTime" },
        "rationale": { "$ref": "#/$defs/text" },
        "approvalPolicy": { "$ref": "#/$defs/externalRef" }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team"],
      "properties": {
        "team": { "type": "string", "minLength": 1, "maxLength": 120 },
        "contact": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "title", "status", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/revision" },
        "title": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "status": { "type": "string" },
        "owner": { "$ref": "#/$defs/owner" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "acceptance": { "$ref": "#/$defs/acceptance" },
        "supersedes": { "$ref": "#/$defs/pinnedContractRef" },
        "labels": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9.-]*$" },
          "additionalProperties": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "metadata", "spec"],
      "properties": {
        "apiVersion": { "$ref": "#/$defs/apiVersion" },
        "kind": { "$ref": "#/$defs/kind" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "spec": { "type": "object" }
      }
    }
  }
}
