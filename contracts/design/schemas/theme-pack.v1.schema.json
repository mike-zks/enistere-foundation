{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enistere.com/schemas/theme-pack/v1",
  "title": "Enistere Theme Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "version", "contractVersion", "institution",
    "selection", "shared", "modes", "assets"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "contractVersion": { "const": "1" },
    "institution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "type": "string", "minLength": 1 }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contexts", "allowUserMode", "followSystem", "fallbackThemeId"],
      "properties": {
        "contexts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "allowUserMode": { "type": "boolean" },
        "followSystem": { "type": "boolean" },
        "fallbackThemeId": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]{1,62}$" }
      }
    },
    "shared": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spacing", "radius", "minimumTouchTarget"],
      "properties": {
        "spacing": { "$ref": "#/$defs/scale" },
        "radius": { "$ref": "#/$defs/scale" },
        "minimumTouchTarget": { "type": "integer", "minimum": 44, "maximum": 96 }
      }
    },
    "modes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["light", "dark"],
      "properties": {
        "light": { "$ref": "#/$defs/mode" },
        "dark": { "$ref": "#/$defs/mode" }
      }
    },
    "assets": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
    "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}(?:[0-9A-Fa-f]{2})?$" },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xs", "sm", "md", "lg", "xl", "xxl"],
      "properties": {
        "xs": { "type": "number", "minimum": 0 },
        "sm": { "type": "number", "minimum": 0 },
        "md": { "type": "number", "minimum": 0 },
        "lg": { "type": "number", "minimum": 0 },
        "xl": { "type": "number", "minimum": 0 },
        "xxl": { "type": "number", "minimum": 0 }
      }
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["colors"],
      "properties": {
        "colors": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "background.default", "background.muted", "background.elevated",
            "foreground.default", "foreground.muted", "foreground.inverse",
            "border.default", "border.strong", "border.focus",
            "action.primary", "action.primaryHover", "action.primaryPressed", "action.disabled",
            "status.success", "status.warning", "status.danger", "status.info",
            "focus.ring", "overlay"
          ],
          "properties": {
            "background.default": { "$ref": "#/$defs/hex" },
            "background.muted": { "$ref": "#/$defs/hex" },
            "background.elevated": { "$ref": "#/$defs/hex" },
            "foreground.default": { "$ref": "#/$defs/hex" },
            "foreground.muted": { "$ref": "#/$defs/hex" },
            "foreground.inverse": { "$ref": "#/$defs/hex" },
            "border.default": { "$ref": "#/$defs/hex" },
            "border.strong": { "$ref": "#/$defs/hex" },
            "border.focus": { "$ref": "#/$defs/hex" },
            "action.primary": { "$ref": "#/$defs/hex" },
            "action.primaryHover": { "$ref": "#/$defs/hex" },
            "action.primaryPressed": { "$ref": "#/$defs/hex" },
            "action.disabled": { "$ref": "#/$defs/hex" },
            "status.success": { "$ref": "#/$defs/hex" },
            "status.warning": { "$ref": "#/$defs/hex" },
            "status.danger": { "$ref": "#/$defs/hex" },
            "status.info": { "$ref": "#/$defs/hex" },
            "focus.ring": { "$ref": "#/$defs/hex" },
            "overlay": { "$ref": "#/$defs/hex" }
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "alt", "modes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["logo", "mark"] },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[a-zA-Z0-9._/-]+$"
        },
        "alt": { "type": "string", "minLength": 1 },
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["light", "dark"] }
        }
      }
    }
  }
}
